# ── Project DAEDALUS — Environment Variables ──────────────────────────────────
# Copy to .env.local (admin/storefront) or set in Secret Manager (functions).

# ── Firebase (client SDKs — admin & storefront) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_PROJECT_ID=daedalus-store
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=daedalus-store.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=daedalus-store.firebasestorage.app
VITE_FIREBASE_PROJECT_ID=daedalus-store
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=daedalus-store.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=daedalus-store.firebasestorage.app

# ── Storefront (Cloud Run) ───────────────────────────────────────────────────
# Canonical public URL (used for robots, sitemap, OG, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://storefront-229074810509.europe-north1.run.app
# Shared secret between functions and the storefront /api/revalidate endpoint.
# Store in Secret Manager as REVALIDATE_TOKEN; deploy.sh passes it via --set-secrets.
REVALIDATE_TOKEN=

# ── Cloud Functions (Secret Manager) ─────────────────────────────────────────
# These must be created in Secret Manager and referenced via defineSecret().
STRIPE_SECRET_KEY=           # Stripe live/test secret
STRIPE_WEBHOOK_SECRET=       # Stripe webhook signing secret
SENDGRID_API_KEY=            # SendGrid mail send API key

# ── Cloud Functions (string params) ──────────────────────────────────────────
# Optional — have sensible defaults in config.ts.
STORE_BASE_URL=https://daedalus-store.web.app
SENDGRID_FROM_EMAIL=orders@daedalus-store.web.app
STOREFRONT_URL=https://storefront-229074810509.europe-north1.run.app
