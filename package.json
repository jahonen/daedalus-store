{
  "name": "daedalus-store",
  "version": "0.1.0",
  "private": true,
  "description": "Project DAEDALUS — Born-in-AI e-commerce engine (EEA native)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:storefront": "npm run dev -w @daedalus/storefront",
    "dev:admin": "npm run dev -w @daedalus/admin",
    "emulators": "firebase emulators:start",
    "provision": "bash infra/scripts/provision.sh",
    "deploy": "bash infra/scripts/deploy.sh",
    "seed": "node infra/scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
