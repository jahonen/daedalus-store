rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public storefront read access: published pages and active products only.
    match /storefrontPages/{pageId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if doc == 'company' || isAdmin();
      allow write: if isAdmin() && doc != 'email';
    }

    // Server-only collections (Admin SDK bypasses rules).
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /inventoryLocks/{lockId} {
      allow read, write: if false;
    }
    match /priceHistory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }
    match /strategy/{docId} {
      allow read, write: if isAdmin();
    }
    match /artisans/{artisanId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Server-only heritage collections (Admin SDK via callables).
    match /heritageRegistry/{docId} {
      allow read, write: if false;
    }
    match /repairRecords/{docId} {
      allow read, write: if false;
    }
    match /admins/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }
    match /analyticsEvents/{docId} {
      allow read, write: if false;
    }
    match /socialPosts/{docId} {
      allow read: if isAdmin();
      allow write: if false; // server-only via publishSocialPost
    }
  }
}
