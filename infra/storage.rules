rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Publicly readable storefront media (product images, generated assets, OG cards).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin uploads staging area — admin only.
    match /uploads/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
